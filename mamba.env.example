# Mamba MCP Configuration
# Copy this file to mamba.env and fill in your values.
# Default locations: ./mamba.env (project-local) or ~/mamba.env (global)

# ── PostgreSQL MCP Server ─────────────────────────────────────────────

# Required
MAMBA_MCP_POSTGRES_DB_NAME=mydb
MAMBA_MCP_POSTGRES_DB_USER=postgres
MAMBA_MCP_POSTGRES_DB_PASSWORD=secret

# Optional (defaults shown)
# MAMBA_MCP_POSTGRES_DB_HOST=localhost
# MAMBA_MCP_POSTGRES_DB_PORT=5432
# MAMBA_MCP_POSTGRES_POOL_SIZE=5
# MAMBA_MCP_POSTGRES_POOL_TIMEOUT=30.0
# MAMBA_MCP_POSTGRES_STATEMENT_TIMEOUT=30000
# MAMBA_MCP_POSTGRES_DEFAULT_SCHEMA=public
# MAMBA_MCP_POSTGRES_TRANSPORT=stdio
# MAMBA_MCP_POSTGRES_SERVER_HOST=0.0.0.0
# MAMBA_MCP_POSTGRES_SERVER_PORT=8080
# MAMBA_MCP_POSTGRES_LOG_LEVEL=INFO
# MAMBA_MCP_POSTGRES_LOG_FORMAT=json
